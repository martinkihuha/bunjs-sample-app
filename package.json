{
  "name": "sample-app",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:css": "bunx @tailwindcss/cli -i src/css/input.css -o public/css/styles.css --watch always",
    "dev:all": "bun run dev:css & bun run dev",
    "build:css": "bunx @tailwindcss/cli -i src/css/input.css -o public/css/styles.css",
    "postinstall": "cp node_modules/htmx.org/dist/htmx.min.js public/js/htmx.min.js"
  },
  "dependencies": {
    "eta": "^4.6.0",
    "hono": "^4.12.32",
    "htmx.org": "^2.0.10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.3"
  }
}