{
  "name": "sample-app",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:css": "bunx @tailwindcss/cli -i src/views/css/input.css -o public/css/styles.css --watch always",
    "dev:js": "bun build src/views/js/app.js --outdir public/js --watch",
    "dev:all": "bun run dev:css & bun run dev:js & bun run dev",
    "build:css": "bunx @tailwindcss/cli -i src/views/css/input.css -o public/css/styles.css",
    "build:js": "bun build src/views/js/app.js --outdir public/js --minify"
  },
  "dependencies": {
    "apexcharts": "^6.7.0",
    "basecoat-css": "^1.0.2",
    "eta": "^4.6.0",
    "hono": "^4.12.32",
    "htmx.org": "2.0.10",
    "iconify-icon": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.3"
  }
}